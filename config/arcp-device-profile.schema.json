{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/arcp/schemas/device-profile-v1.json",
  "title": "ARCP external device profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "application_id",
    "deployment_mode",
    "android_identity",
    "capabilities",
    "paths"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "application_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "deployment_mode": { "enum": ["upgrade", "first_install"] },
    "adb_serial_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "default": "ADB_SERIAL" },
    "android_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "device", "min_sdk", "abi_any_of"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "min_sdk": { "type": "integer", "minimum": 21 },
        "max_sdk": { "type": "integer", "minimum": 21 },
        "abi_any_of": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_tunnel", "pin_provisioning", "first_install", "require_32bit"],
      "properties": {
        "fallback_tunnel": { "type": "boolean" },
        "pin_provisioning": { "type": "boolean" },
        "first_install": { "type": "boolean" },
        "require_32bit": { "type": "boolean" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android_config", "apply", "verify", "secrets"],
      "properties": {
        "android_config": { "type": "string", "minLength": 1 },
        "apply": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 },
        "secrets": { "type": "string", "minLength": 1 }
      }
    }
  }
}
